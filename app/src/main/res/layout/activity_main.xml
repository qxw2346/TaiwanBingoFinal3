<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginBottom="6dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#333333"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDrawStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="台彩賓果 9 因子分析引擎"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCountdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="開獎倒數: 計算中..."
                                android:textColor="#FFD700"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSecurityBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="6dp"
                            android:text="● 三源驗證"
                            android:textColor="#52C41A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#333333"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📈 模型命中率實戰檢驗 (基準: 1.25 / 2.50 / 5.00)"
                            android:textColor="#FFD700"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHitRateStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="近 30 期盲測: Top5[--] Top10[--] Top20[--]"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvLastHitDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="上期對標命中: -- 顆"
                            android:textColor="#52C41A"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#333333"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:text="⚙️ 9 因子自訂權重 (防誤觸鎖定)"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnToggleLock"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_alignParentEnd="true"
                                android:text="🔒 點擊解鎖"
                                android:textSize="11sp" />
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/tvWeightMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp"
                            android:text="狀態: 永久鎖定中 (防手滑修改)"
                            android:textColor="#8C8C8C"
                            android:textSize="11sp" />

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:stretchColumns="*">

                            <TableRow
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="2dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="A 貝氏平滑"
                                        android:textColor="#8C8C8C"
                                        android:textSize="10sp" />

                                    <EditText
                                        android:id="@+id/etWeightA"
                                        android:layout_width="match_parent"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_edit_box"
                                        android:inputType="number"
                                        android:textAlignment="center"
                                        android:textColor="#FFFFFF" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="2dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="B 近期動能"
                                        android:textColor="#8C8C8C"
                                        android:textSize="10sp" />

                                    <EditText
                                        android:id="@+id/etWeightB"
                                        android:layout_width="match_parent"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_edit_box"
                                        android:inputType="number"
                                        android:textAlignment="center"
                                        android:textColor="#FFFFFF" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="2dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="C 指數衰減"
                                        android:textColor="#8C8C8C"
                                        android:textSize="10sp" />

                                    <EditText
                                        android:id="@+id/etWeightC"
                                        android:layout_width="match_parent"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_edit_box"
                                        android:inputType="number"
                                        android:textAlignment="center"
                                        android:textColor="#FFFFFF" />
                                </LinearLayout>
                            </TableRow>

                            <TableRow
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="2dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="D 遺漏動態"
                                        android:textColor="#8C8C8C"
                                        android:textSize="10sp" />

                                    <EditText
                                        android:id="@+id/etWeightD"
                                        android:layout_width="match_parent"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_edit_box"
                                        android:inputType="number"
                                        android:textAlignment="center"
                                        android:textColor="#FFFFFF" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="2dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="E 尾數熱度"
                                        android:textColor="#8C8C8C"
                                        android:textSize="10sp" />

                                    <EditText
                                        android:id="@+id/etWeightE"
                                        android:layout_width="match_parent"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_edit_box"
                                        android:inputType="number"
                                        android:textAlignment="center"
                                        android:textColor="#FFFFFF" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="2dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="F 區段穩定"
                                        android:textColor="#8C8C8C"
                                        android:textSize="10sp" />

                                    <EditText
                                        android:id="@+id/etWeightF"
                                        android:layout_width="match_parent"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_edit_box"
                                        android:inputType="number"
                                        android:textAlignment="center"
                                        android:textColor="#FFFFFF" />
                                </LinearLayout>
                            </TableRow>

                            <TableRow
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="2dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="G 馬可夫鏈"
                                        android:textColor="#8C8C8C"
                                        android:textSize="10sp" />

                                    <EditText
                                        android:id="@+id/etWeightG"
                                        android:layout_width="match_parent"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_edit_box"
                                        android:inputType="number"
                                        android:textAlignment="center"
                                        android:textColor="#FFFFFF" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="2dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="H 同伴共現"
                                        android:textColor="#8C8C8C"
                                        android:textSize="10sp" />

                                    <EditText
                                        android:id="@+id/etWeightH"
                                        android:layout_width="match_parent"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_edit_box"
                                        android:inputType="number"
                                        android:textAlignment="center"
                                        android:textColor="#FFFFFF" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="2dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="I 四區輪動"
                                        android:textColor="#8C8C8C"
                                        android:textSize="10sp" />

                                    <EditText
                                        android:id="@+id/etWeightI"
                                        android:layout_width="match_parent"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_edit_box"
                                        android:inputType="number"
                                        android:textAlignment="center"
                                        android:textColor="#FFFFFF" />
                                </LinearLayout>
                            </TableRow>
                        </TableLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnSaveWeights"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:text="💾 儲存套用"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnResetWeights"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:text="🔄 恢復預設"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnOptimizeWeights"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1.2"
                                android:text="🤖 測算最佳化"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnExportWeights"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="2dp"
                                android:layout_weight="0.9"
                                android:text="📤 匯出"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btnImportWeights"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="2dp"
                                android:layout_weight="0.9"
                                android:text="📥 匯入"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#FFD700"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎯 下期開獎精選命中名單"
                                android:textColor="#FFD700"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnCopyTop"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_alignParentEnd="true"
                                android:text="複製號碼"
                                android:textSize="11sp" />
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/tvTop5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="🔥 Top 5 核心: 計算中..."
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTop10"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="⚡ Top 10 黃金: 計算中..."
                            android:textColor="#FFA940"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvTop20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="📋 Top 20 對標: 計算中..."
                            android:textColor="#8C8C8C"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#333333"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="🌡️ 80 號 9 因子熱度矩陣 (紅=熱 / 藍=冷)"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <GridLayout
                            android:id="@+id/gridHeatmap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alignmentMode="alignMargins"
                            android:columnCount="10"
                            android:useDefaultMargins="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Button
                    android:id="@+id/btnRefreshAll"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🔄 立即刷新開獎數據並重算"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
